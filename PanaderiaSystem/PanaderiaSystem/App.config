<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Ajusta servidor, base, usuario y contraseña de tu PostgreSQL.
             En una panadería real no uses el superusuario postgres; crea un rol propio (en psql, como postgres):
               CREATE ROLE migacore LOGIN PASSWORD 'una-contraseña-larga';
               CREATE DATABASE migacore OWNER migacore;
             y aquí: Username=migacore;Password=una-contraseña-larga
             Después de compilar, este archivo se llama PanaderiaSystem.exe.config junto al .exe. -->
        <add name="MigaCore" connectionString="Host=localhost;Port=5432;Database=migacore;Username=postgres;Password=postgres" />
    </connectionStrings>
</configuration>
